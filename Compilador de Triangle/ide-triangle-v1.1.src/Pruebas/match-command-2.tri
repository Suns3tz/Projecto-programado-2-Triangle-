let
  var mes : Integer;
  var dias : Integer
in
  begin
    mes := 2;

    match mes of
      case 2 : dias := 28
      case 1 : dias := 31
      case 3 : dias := 31
      case 5 : dias := 31
      case 7 : dias := 31
      case 8 : dias := 31
      case 10 : dias := 31
      case 12 : dias := 31
      otherwise : dias := 30
    end
 end